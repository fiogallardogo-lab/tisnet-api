# ============================================
# TISNET API - Environment variables example
# ============================================

# --------------------------------------------
# Database - local development
# --------------------------------------------
# When NestJS runs directly on Windows/local machine,
# MySQL is accessed through localhost.
DATABASE_URL="mysql://tisnet_user:your_password@localhost:3306/tisnet"


# --------------------------------------------
# JWT
# --------------------------------------------
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRATION="15m"

JWT_REFRESH_SECRET="change_me_to_another_long_random_secret"
JWT_REFRESH_EXPIRATION="7d"


# --------------------------------------------
# Application
# --------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:5173


# --------------------------------------------
# MySQL - Docker Compose
# --------------------------------------------
# These variables are used by docker-compose.yml.
# Inside Docker, the API connects to the service
# hostname "mysql", not localhost.

MYSQL_ROOT_PASSWORD="change_me_root_password"
MYSQL_DATABASE="tisnet"
MYSQL_USER="tisnet_user"
MYSQL_PASSWORD="change_me_user_password"