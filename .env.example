# ============================================
# TISNET API - Environment variables example
# ============================================

# --------------------------------------------
# Database - local development
# --------------------------------------------
# When NestJS runs directly on Windows/local machine,
# MySQL is accessed through localhost:3307 (exposed by Docker).
DATABASE_URL="mysql://tisnet_user:your_password@localhost:3307/tisnet"

# Optional: Separate database for E2E tests (or use .env.test)
# DATABASE_URL_TEST="mysql://tisnet_user:your_password@localhost:3307/tisnet_test"


# --------------------------------------------
# JWT
# --------------------------------------------
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRATION="15m"

JWT_REFRESH_SECRET="change_me_to_another_long_random_secret"
JWT_REFRESH_EXPIRATION="7d"


# --------------------------------------------
# Application
# --------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:5173

# Approved legal versions for CLIENT registration and authenticated acceptance renewal.
TERMS_VERSION="v1.0"
PRIVACY_VERSION="v1.0"


# --------------------------------------------
# MySQL - Docker Compose
# --------------------------------------------
# These variables are used by docker-compose.yml.
# Inside Docker, the API connects to the service
# hostname "mysql", not localhost.

MYSQL_ROOT_PASSWORD="change_me_root_password"
MYSQL_DATABASE="tisnet"
MYSQL_USER="tisnet_user"
MYSQL_PASSWORD="change_me_user_password"

# Development/test users created by `npm run prisma:seed`
SEED_ADMIN_EMAIL="admin@tisnet.test"
SEED_ADMIN_PASSWORD="change_me_admin_password"
SEED_DEVELOPER_EMAIL="developer@tisnet.test"
SEED_DEVELOPER_PASSWORD="change_me_developer_password"

# Notifications: simulation only; no messages leave the process.
# Real provider, verified sender, credentials and delivery policy await team approval.
NOTIFICATION_PROVIDER=fake
# Future delivery policy (DESIGNED ONLY; not read/applied by the current fake):
# NOTIFICATION_TIMEOUT_MS=5000
# NOTIFICATION_MAX_RETRIES=2

# --------------------------------------------
# Notifications (provider configuration)
# --------------------------------------------
# NOTIFICATION_PROVIDER=fake      <- default; in-memory, safe for tests and local dev
# NOTIFICATION_PROVIDER=smtp      <- real SMTP relay
# NOTIFICATION_PROVIDER=resend    <- Resend.com API
# MAIL_FROM=TISNET <no-reply@tisnet.pe>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# RESEND_API_KEY=re_xxxxxxxxxxxx

# --------------------------------------------
# Storage
# --------------------------------------------
# STORAGE_DRIVER=memory     <- default; in-memory (tests / local dev)
# STORAGE_DRIVER=disk       <- persistent local disk (staging)
# STORAGE_DISK_PATH=/absolute/path/to/storage-data
# STORAGE_BASE_URL=http://localhost:3000/storage

# --------------------------------------------
# Culqi (Payment Gateway)
# --------------------------------------------
# Disabled until sandbox validation and explicit activation.
CULQI_ENABLED=false
PAYMENT_DRIVER=fake
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_BASIC_AUTH=
# SECRET_KEY is the server private key. Never put it in a VITE_ variable.
# BASIC_AUTH is base64(user:password), matching the Culqi dashboard.

# --------------------------------------------
# Signed URLs (secure file downloads)
# --------------------------------------------
# SIGNED_URL_SECRET=change_me_to_a_long_random_secret_for_hmac
# SIGNED_URL_TTL_SECONDS=300    <- default: 300 s (5 min)

# --------------------------------------------
# Calendly (Meeting Scheduling)
# --------------------------------------------
# CALENDLY_API_KEY=eyJhbGciOiJIUzI1NiJ9.xxxx
# CALENDLY_WEBHOOK_SECRET=change_me_calendly_webhook_secret

# --------------------------------------------
# Password Recovery
# --------------------------------------------
# JWT_RESET_PASSWORD_SECRET=change_me_to_a_long_random_reset_secret
# JWT_RESET_PASSWORD_EXPIRATION=15m

# --------------------------------------------
# Rate Limiting (ThrottlerModule)
# Configured in code; overridable at runtime if needed.
# --------------------------------------------
# THROTTLE_DEFAULT_TTL=60000    <- ms; default per-route window
# THROTTLE_DEFAULT_LIMIT=120    <- requests per window (general)
# (auth routes: 5�10 req/window; webhook: 60 req/window)


# Sprint 15 A: approved commercial policy (no production defaults for cutoff/version)
PAYMENT_REMINDERS_ENABLED=false
PAYMENT_REMINDER_TRIGGER=APPROVED
# PAYMENT_REMINDER_CUTOFF=HH:mm
# PAYMENT_REMINDER_POLICY_VERSION=<approved-policy-version>
# PAYMENT_REMINDER_EXTRA_HOLIDAYS=YYYY-MM-DD,YYYY-MM-DD
# LEGAL_CONTENT_FILE=/run/config/approved-legal.json
# LEGAL_REQUIRE_PUBLISHED=true
# PUBLIC_TEAM_MEDIA_HOSTS=<approved-public-assets-host>
