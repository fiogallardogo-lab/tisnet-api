# ============================================
# TISNET API - Environment variables example
# ============================================

# --------------------------------------------
# Database - local development
# --------------------------------------------
# When NestJS runs directly on Windows/local machine,
# MySQL is accessed through localhost:3307 (exposed by Docker).
DATABASE_URL="mysql://tisnet_user:your_password@localhost:3307/tisnet"

# Optional: Separate database for E2E tests (or use .env.test)
# DATABASE_URL_TEST="mysql://tisnet_user:your_password@localhost:3307/tisnet_test"


# --------------------------------------------
# JWT
# --------------------------------------------
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRATION="15m"

JWT_REFRESH_SECRET="change_me_to_another_long_random_secret"
JWT_REFRESH_EXPIRATION="7d"


# --------------------------------------------
# Application
# --------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:5173

# Approved legal versions for CLIENT registration and authenticated acceptance renewal.
TERMS_VERSION="v1.0"
PRIVACY_VERSION="v1.0"


# --------------------------------------------
# MySQL - Docker Compose
# --------------------------------------------
# These variables are used by docker-compose.yml.
# Inside Docker, the API connects to the service
# hostname "mysql", not localhost.

MYSQL_ROOT_PASSWORD="change_me_root_password"
MYSQL_DATABASE="tisnet"
MYSQL_USER="tisnet_user"
MYSQL_PASSWORD="change_me_user_password"

# Development/test users created by `npm run prisma:seed`
SEED_ADMIN_EMAIL="admin@tisnet.test"
SEED_ADMIN_PASSWORD="change_me_admin_password"
SEED_DEVELOPER_EMAIL="developer@tisnet.test"
SEED_DEVELOPER_PASSWORD="change_me_developer_password"

# Notifications: simulation only; no messages leave the process.
# Real provider, verified sender, credentials and delivery policy await team approval.
NOTIFICATION_PROVIDER=fake
# Future delivery policy (DESIGNED ONLY; not read/applied by the current fake):
# NOTIFICATION_TIMEOUT_MS=5000
# NOTIFICATION_MAX_RETRIES=2
