# ============================================
# TISNET API - E2E Testing Environment Example
# ============================================
# Copia este archivo como .env.test para ejecutar las
# pruebas E2E contra una base de datos aislada sin
# afectar los datos de desarrollo.

NODE_ENV="test"

# --------------------------------------------
# Database - Test Environment
# --------------------------------------------
# Base de datos separada para tests (ej. tisnet_test en puerto 3307)
DATABASE_URL="mysql://tisnet_user:your_password@localhost:3307/tisnet_test"

# La base debe existir antes de la primera ejecución. Después puedes preparar
# sus tablas y usuarios con `npm run test:e2e:prepare`, o ejecutar todo el
# proceso con `npm run test:e2e:full`.

# --------------------------------------------
# JWT - Claves para pruebas
# --------------------------------------------
JWT_SECRET="test_jwt_secret_key_for_testing_purposes_only"
JWT_EXPIRATION="15m"

JWT_REFRESH_SECRET="test_jwt_refresh_secret_key_for_testing_purposes_only"
JWT_REFRESH_EXPIRATION="7d"

# --------------------------------------------
# Application
# --------------------------------------------
PORT=3001
FRONTEND_URL="http://localhost:5173"

# --------------------------------------------
# Usuarios de prueba para E2E
# --------------------------------------------
# Estas credenciales son las esperadas por test/app.e2e-spec.ts
SEED_ADMIN_EMAIL="admin@tisnet.test"
SEED_ADMIN_PASSWORD="Test1234!"
SEED_DEVELOPER_EMAIL="developer@tisnet.test"
SEED_DEVELOPER_PASSWORD="DevTest1234!"
