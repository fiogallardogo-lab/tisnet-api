# Copy to .env.staging outside Git. HTTPS reverse proxy required on the deployment host.
NODE_ENV=staging
APP_COMMIT=REPLACE_WITH_FULL_GIT_COMMIT
FRONTEND_URL=https://REPLACE_FRONTEND_DOMAIN
MYSQL_DATABASE=tisnet_staging
MYSQL_USER=tisnet
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DISTINCT_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# ONLY for the first run on a verified empty database. Set false for every later start.
ALLOW_EMPTY_DB_BASELINE=false
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=/app/storage-data
CALENDLY_WEBHOOK_SECRET=REPLACE_WITH_PROVIDER_SIGNING_SECRET
# Configure actual email provider and approved legal/reminder settings from .env.example.
# Do not label CONFIGURED integration status as a successful external delivery test.
PAYMENT_REMINDERS_ENABLED=false
