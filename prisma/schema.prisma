// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  IN_DEVELOPMENT
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum QuoteStatus {
  RECEIVED
}

enum QuotePricingStatus {
  PENDING_RULES
  CALCULATED
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum ProspectSource {
  QUOTE
  MEETING
  MANUAL
}

enum MeetingStatus {
  REQUESTED
  CONFIRMED
  CANCELED
  COMPLETED
}

enum ProjectMemberRole {
  CLIENT
  DEVELOPER
  PRODUCT_OWNER
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  OBSERVED
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id                   Int                  @id @default(autoincrement())
  name                 String               @db.VarChar(100)
  email                String               @unique @db.VarChar(150)
  passwordHash         String               @db.VarChar(255)
  roleId               Int
  isActive             Boolean              @default(true)
  acceptedTermsAt      DateTime?
  termsVersion         String?              @db.VarChar(50)
  privacyVersion       String?              @db.VarChar(50)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  tokenVersion         Int                  @default(0)
  role                 Role                 @relation(fields: [roleId], references: [id])
  clientProfile        ClientProfile?
  developerProfile     DeveloperProfile?
  productOwnerProfile  ProductOwnerProfile?
  adminProfile         AdminProfile?
  prospect             Prospect?
  projectMemberships   ProjectMember[]
  reviewedDeliverables ProjectDeliverable[] @relation("DeliverableReviewer")

  @@index([roleId, isActive])
}

model ClientProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  dni              String?  @unique @db.VarChar(8)
  age              Int?
  phone            String?  @db.VarChar(20)
  district         String?  @db.VarChar(100)
  businessName     String?  @db.VarChar(150)
  ruc              String?  @unique @db.VarChar(11)
  commercialName   String?  @db.VarChar(150)
  businessDistrict String?  @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeveloperProfile {
  id              Int                   @id @default(autoincrement())
  userId          Int                   @unique
  career          String?               @db.VarChar(150)
  university      String?               @db.VarChar(180)
  academicStatus  String?               @db.VarChar(100)
  experienceYears Int?
  specialty       String?               @db.VarChar(120)
  cvUrl           String?               @db.VarChar(500)
  photoUrl        String?               @db.VarChar(500)
  linkedinUrl     String?               @db.VarChar(500)
  githubUrl       String?               @db.VarChar(500)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  technologies    DeveloperTechnology[]
}

model DeveloperTechnology {
  developerProfileId Int
  technologyId       Int
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  technology         Technology       @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([developerProfileId, technologyId])
  @@index([technologyId])
}

model ProductOwnerProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  bio               String?  @db.Text
  specialty         String?  @db.VarChar(120)
  availabilityNotes String?  @db.VarChar(500)
  photoUrl          String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  executiveTitle  String?   @db.VarChar(120)
  specialty       String?   @db.VarChar(120)
  photoUrl        String?   @db.VarChar(500)
  calendlyUrl     String?   @db.VarChar(500)
  isPublicAdvisor Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisedMeetings Meeting[] @relation("MeetingAdvisor")
}

model Quote {
  id             Int                @id @default(autoincrement())
  publicCode     String             @unique @db.VarChar(20)
  status         QuoteStatus        @default(RECEIVED)
  solutionType   String             @db.VarChar(64)
  contactName    String             @db.VarChar(100)
  contactEmail   String             @db.VarChar(150)
  contactPhone   String             @db.VarChar(30)
  contactCompany String?            @db.VarChar(150)
  notes          String?            @db.Text
  pricingStatus  QuotePricingStatus @default(PENDING_RULES)
  amountMinor    Decimal?           @db.Decimal(15, 0)
  currency       String?            @db.Char(3)
  pricingVersion String?            @db.VarChar(50)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  prospectId     Int?
  options        QuoteOption[]
  items          QuoteItem[]
  prospect       Prospect?          @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  meetings       Meeting[]

  @@index([status, createdAt])
  @@index([pricingStatus, createdAt])
  @@index([solutionType, createdAt])
  @@index([prospectId, createdAt])
}

model Prospect {
  id        Int            @id @default(autoincrement())
  userId    Int?           @unique
  name      String         @db.VarChar(100)
  email     String         @unique @db.VarChar(150)
  phone     String?        @db.VarChar(30)
  company   String?        @db.VarChar(150)
  status    ProspectStatus @default(NEW)
  source    ProspectSource @default(QUOTE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotes    Quote[]
  meetings  Meeting[]

  @@index([status, createdAt])
  @@index([source, createdAt])
}

model Meeting {
  id               Int           @id @default(autoincrement())
  prospectId       Int
  quoteId          Int?
  advisorProfileId Int?
  status           MeetingStatus @default(REQUESTED)
  scheduledAt      DateTime?
  timezone         String        @default("America/Lima") @db.VarChar(64)
  notes            String?       @db.VarChar(1000)
  externalProvider String?       @db.VarChar(50)
  externalEventUri String?       @unique @db.VarChar(500)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  prospect         Prospect      @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  quote            Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  advisorProfile   AdminProfile? @relation("MeetingAdvisor", fields: [advisorProfileId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
  @@index([quoteId])
  @@index([advisorProfileId, scheduledAt])
  @@index([status, scheduledAt])
}

model QuoteOption {
  id           Int      @id @default(autoincrement())
  quoteId      Int
  optionCode   String   @db.VarChar(64)
  optionName   String   @db.VarChar(150)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, optionCode])
  @@index([quoteId, displayOrder])
}

model QuoteItem {
  id           Int      @id @default(autoincrement())
  quoteId      Int
  itemCode     String   @db.VarChar(64)
  label        String   @db.VarChar(150)
  amountMinor  Decimal  @db.Decimal(15, 0)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, itemCode])
  @@index([quoteId, displayOrder])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Technology {
  id          Int                   @id @default(autoincrement())
  name        String                @unique @db.VarChar(100)
  description String?               @db.Text
  icon        String?               @db.VarChar(255)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  projects    ProjectTechnology[]
  developers  DeveloperTechnology[]
}

model Project {
  id               Int                  @id @default(autoincrement())
  name             String               @db.VarChar(150)
  slug             String               @unique @db.VarChar(180)
  shortDescription String               @db.VarChar(300)
  description      String               @db.Text
  problem          String?              @db.Text
  solution         String?              @db.Text
  objective        String?              @db.Text
  features         Json?
  categoryId       Int
  status           ProjectStatus        @default(DRAFT)
  developmentDate  DateTime?            @db.Date
  clientName       String?              @db.VarChar(150)
  demoUrl          String?              @db.VarChar(500)
  externalUrl      String?              @db.VarChar(500)
  coverImageUrl    String?              @db.VarChar(500)
  isFeatured       Boolean              @default(false)
  isPublished      Boolean              @default(false)
  displayOrder     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  technologies     ProjectTechnology[]
  members          ProjectMember[]
  deliverables     ProjectDeliverable[]

  @@index([categoryId])
  @@index([status])
  @@index([isPublished, displayOrder])
}

model ProjectMember {
  id         Int               @id @default(autoincrement())
  projectId  Int
  userId     Int
  memberRole ProjectMemberRole
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, isActive])
  @@index([projectId, memberRole, isActive])
}

model ProjectDeliverable {
  id             Int               @id @default(autoincrement())
  projectId      Int
  title          String            @db.VarChar(150)
  description    String            @db.Text
  milestoneOrder Int
  dueDate        DateTime          @db.Date
  status         DeliverableStatus @default(DRAFT)
  fileUrl        String?           @db.VarChar(500)
  externalLink   String?           @db.VarChar(500)
  feedbackNotes  String?           @db.VarChar(2000)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy     User?             @relation("DeliverableReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([projectId, milestoneOrder])
  @@index([projectId, status, dueDate])
  @@index([reviewedById])
}

model ProjectTechnology {
  projectId    Int
  technologyId Int
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model Service {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(150)
  slug             String   @unique @db.VarChar(180)
  shortDescription String   @db.VarChar(300)
  description      String   @db.Text
  icon             String?  @db.VarChar(100)
  imageUrl         String?  @db.VarChar(500)
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([isFeatured])
}

model PublicQuote {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(100)
  solutionType   String   @db.VarChar(40)
  deliveryMode   String   @db.VarChar(20)
  contact        Json
  notes          String?  @db.Text
  snapshot       Json
  pricingStatus  String   @db.VarChar(30)
  amountMinor    Int?
  currency       String?  @db.VarChar(3)
  pricingVersion String?  @db.VarChar(30)
  createdAt      DateTime @default(now())
}

model TeamApplication {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  dni           String   @unique @db.VarChar(8)
  requestedRole String   @db.VarChar(30)
  profile       Json
  cv            Bytes    @db.LongBlob
  cvName        String   @db.VarChar(255)
  photo         Bytes    @db.LongBlob
  photoMime     String   @db.VarChar(30)
  consent       Boolean
  status        String   @default("PENDING_REVIEW") @db.VarChar(30)
  createdAt     DateTime @default(now())
}
