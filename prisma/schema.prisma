// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  IN_DEVELOPMENT
  IN_REVIEW
  COMPLETED
  ARCHIVED
}

enum QuoteStatus {
  RECEIVED
}

enum QuotePricingStatus {
  PENDING_RULES
  CALCULATED
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum ProspectSource {
  QUOTE
  MEETING
  MANUAL
}

enum MeetingStatus {
  PENDING   @map("REQUESTED")
  SCHEDULED @map("CONFIRMED")
  CANCELLED @map("CANCELED")
  COMPLETED
}

enum ProjectMemberRole {
  CLIENT
  DEVELOPER
  PRODUCT_OWNER
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  OBSERVED
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  resultingApplications    TeamApplication[]    @relation("ApplicationAccount")
  applicationDecisions     TeamApplication[]    @relation("ApplicationDecisionActor")
  ownedProjects            Project[]            @relation("ProjectOwner")
  clientProjects           Project[]            @relation("ProjectClient")
  kickoffs                 Kickoff[]
  auditEvents              AuditEvent[]
  id                       Int                  @id @default(autoincrement())
  name                     String               @db.VarChar(100)
  email                    String               @unique @db.VarChar(150)
  passwordHash             String               @db.VarChar(255)
  roleId                   Int
  isActive                 Boolean              @default(true)
  acceptedTermsAt          DateTime?
  termsVersion             String?              @db.VarChar(50)
  privacyVersion           String?              @db.VarChar(50)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  tokenVersion             Int                  @default(0)
  role                     Role                 @relation(fields: [roleId], references: [id])
  clientProfile            ClientProfile?
  developerProfile         DeveloperProfile?
  productOwnerProfile      ProductOwnerProfile?
  adminProfile             AdminProfile?
  prospect                 Prospect?
  projectMemberships       ProjectMember[]
  reviewedDeliverables     ProjectDeliverable[] @relation("DeliverableReviewer")
  authoredQuoteVersions    QuoteVersion[]       @relation("QuoteVersionAuthor")
  commercialQuotes         QuoteVersion[]       @relation("QuoteVersionClient")
  reviewedTeamApplications TeamApplication[]    @relation("TeamApplicationReviewer")

  @@index([roleId, isActive])
}

model ClientProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  dni              String?  @unique @db.VarChar(8)
  age              Int?
  phone            String?  @db.VarChar(20)
  district         String?  @db.VarChar(100)
  businessName     String?  @db.VarChar(150)
  ruc              String?  @unique @db.VarChar(11)
  commercialName   String?  @db.VarChar(150)
  businessDistrict String?  @db.VarChar(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeveloperProfile {
  id              Int                   @id @default(autoincrement())
  userId          Int                   @unique
  career          String?               @db.VarChar(150)
  university      String?               @db.VarChar(180)
  academicStatus  String?               @db.VarChar(100)
  experienceYears Int?
  specialty       String?               @db.VarChar(120)
  cvUrl           String?               @db.VarChar(500)
  photoUrl        String?               @db.VarChar(500)
  linkedinUrl     String?               @db.VarChar(500)
  githubUrl       String?               @db.VarChar(500)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  technologies    DeveloperTechnology[]
}

model DeveloperTechnology {
  developerProfileId Int
  technologyId       Int
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  technology         Technology       @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([developerProfileId, technologyId])
  @@index([technologyId])
}

model ProductOwnerProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  bio               String?  @db.Text
  specialty         String?  @db.VarChar(120)
  availabilityNotes String?  @db.VarChar(500)
  photoUrl          String?  @db.VarChar(500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id                       Int               @id @default(autoincrement())
  userId                   Int               @unique
  executiveTitle           String?           @db.VarChar(120)
  specialty                String?           @db.VarChar(120)
  photoUrl                 String?           @db.VarChar(500)
  calendlyUrl              String?           @db.VarChar(500)
  isPublicAdvisor          Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisedMeetings          Meeting[]         @relation("MeetingAdvisor")
  assignedTeamApplications TeamApplication[] @relation("TeamApplicationInterviewer")
}

model Quote {
  id                  Int                @id @default(autoincrement())
  publicCode          String             @unique @db.VarChar(20)
  status              QuoteStatus        @default(RECEIVED)
  solutionType        String             @db.VarChar(64)
  contactName         String             @db.VarChar(100)
  contactEmail        String             @db.VarChar(150)
  contactPhone        String             @db.VarChar(30)
  contactCompany      String?            @db.VarChar(150)
  notes               String?            @db.Text
  pricingStatus       QuotePricingStatus @default(PENDING_RULES)
  amountMinor         Decimal?           @db.Decimal(15, 0)
  currency            String?            @db.Char(3)
  pricingVersion      String?            @db.VarChar(50)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deliveryMode        String             @default("NORMAL") @db.VarChar(20)
  snapshot            Json?
  legacyCode          String?            @unique @db.VarChar(100)
  legacyPublicQuoteId Int?               @unique
  activeVersion       Int                @default(0)
  versions            QuoteVersion[]
  project             Project?
  prospectId          Int?
  options             QuoteOption[]
  items               QuoteItem[]
  prospect            Prospect?          @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  meetings            Meeting[]

  @@index([status, createdAt])
  @@index([pricingStatus, createdAt])
  @@index([solutionType, createdAt])
  @@index([prospectId, createdAt])
}

model Prospect {
  projects  Project[]
  id        Int            @id @default(autoincrement())
  userId    Int?           @unique
  name      String         @db.VarChar(100)
  email     String         @unique @db.VarChar(150)
  phone     String?        @db.VarChar(30)
  company   String?        @db.VarChar(150)
  status    ProspectStatus @default(NEW)
  source    ProspectSource @default(QUOTE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotes    Quote[]
  meetings  Meeting[]

  @@index([status, createdAt])
  @@index([source, createdAt])
}

model Meeting {
  id               Int            @id @default(autoincrement())
  prospectId       Int
  quoteId          Int?
  advisorProfileId Int?
  status           MeetingStatus  @default(PENDING)
  scheduledAt      DateTime?
  timezone         String         @default("America/Lima") @db.VarChar(64)
  notes            String?        @db.VarChar(1000)
  endsAt           DateTime?
  bookingKey       String?        @unique @db.VarChar(180)
  externalEvents   MeetingEvent[]
  externalProvider String?        @db.VarChar(50)
  externalEventUri String?        @unique @db.VarChar(500)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  prospect         Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  quote            Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  advisorProfile   AdminProfile?  @relation("MeetingAdvisor", fields: [advisorProfileId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
  @@index([quoteId])
  @@index([advisorProfileId, scheduledAt])
  @@index([status, scheduledAt])
}

model QuoteOption {
  id           Int      @id @default(autoincrement())
  quoteId      Int
  optionCode   String   @db.VarChar(64)
  optionName   String   @db.VarChar(150)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, optionCode])
  @@index([quoteId, displayOrder])
}

model QuoteItem {
  id           Int      @id @default(autoincrement())
  quoteId      Int
  itemCode     String   @db.VarChar(64)
  label        String   @db.VarChar(150)
  amountMinor  Decimal  @db.Decimal(15, 0)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, itemCode])
  @@index([quoteId, displayOrder])
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Technology {
  id          Int                   @id @default(autoincrement())
  name        String                @unique @db.VarChar(100)
  description String?               @db.Text
  icon        String?               @db.VarChar(255)
  categoryId  Int?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  category    TechnologyCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  projects    ProjectTechnology[]
  developers  DeveloperTechnology[]

  @@index([categoryId])
  @@index([isActive, categoryId])
}

model TechnologyCategory {
  id           Int          @id @default(autoincrement())
  name         String       @unique @db.VarChar(100)
  slug         String       @unique @db.VarChar(120)
  description  String?      @db.Text
  isActive     Boolean      @default(true)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  technologies Technology[]

  @@index([isActive, displayOrder])
}

model Project {
  clientUserId     Int?
  prospectId       Int?
  productOwnerId   Int?
  client           User?                @relation("ProjectClient", fields: [clientUserId], references: [id], onDelete: Restrict)
  prospect         Prospect?            @relation(fields: [prospectId], references: [id], onDelete: Restrict)
  productOwner     User?                @relation("ProjectOwner", fields: [productOwnerId], references: [id], onDelete: Restrict)
  kickoff          Kickoff?
  milestones       ProjectMilestone[]
  id               Int                  @id @default(autoincrement())
  name             String               @db.VarChar(150)
  slug             String               @unique @db.VarChar(180)
  shortDescription String               @db.VarChar(300)
  description      String               @db.Text
  problem          String?              @db.Text
  solution         String?              @db.Text
  objective        String?              @db.Text
  features         Json?
  categoryId       Int
  status           ProjectStatus        @default(DRAFT)
  developmentDate  DateTime?            @db.Date
  clientName       String?              @db.VarChar(150)
  demoUrl          String?              @db.VarChar(500)
  externalUrl      String?              @db.VarChar(500)
  coverImageUrl    String?              @db.VarChar(500)
  isFeatured       Boolean              @default(false)
  isPublished      Boolean              @default(false)
  displayOrder     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  quoteId          Int?                 @unique
  quote            Quote?               @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  technologies     ProjectTechnology[]
  members          ProjectMember[]
  deliverables     ProjectDeliverable[]

  @@index([clientUserId, status])
  @@index([prospectId])
  @@index([productOwnerId, status])
  @@index([categoryId])
  @@index([status])
  @@index([isPublished, displayOrder])
}

model ProjectMember {
  participationBasisPoints Int               @default(0)
  id                       Int               @id @default(autoincrement())
  projectId                Int
  userId                   Int
  memberRole               ProjectMemberRole
  isActive                 Boolean           @default(true)
  createdAt                DateTime          @default(now())
  project                  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, isActive])
  @@index([projectId, memberRole, isActive])
}

model ProjectDeliverable {
  milestoneId    Int?
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  id             Int               @id @default(autoincrement())
  projectId      Int
  title          String            @db.VarChar(150)
  description    String            @db.Text
  milestoneOrder Int
  dueDate        DateTime          @db.Date
  status         DeliverableStatus @default(DRAFT)
  fileUrl        String?           @db.VarChar(500)
  externalLink   String?           @db.VarChar(500)
  feedbackNotes  String?           @db.VarChar(2000)
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedById   Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewedBy     User?             @relation("DeliverableReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([projectId, milestoneOrder])
  @@index([milestoneId])
  @@index([projectId, status, dueDate])
  @@index([reviewedById])
}

model ProjectTechnology {
  projectId    Int
  technologyId Int
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Restrict)

  @@id([projectId, technologyId])
  @@index([technologyId])
}

model Service {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(150)
  slug             String   @unique @db.VarChar(180)
  shortDescription String   @db.VarChar(300)
  description      String   @db.Text
  icon             String?  @db.VarChar(100)
  imageUrl         String?  @db.VarChar(500)
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  isFeatured       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([isFeatured])
}

model PublicQuote {
  id             Int      @id @default(autoincrement())
  code           String   @unique @db.VarChar(100)
  solutionType   String   @db.VarChar(40)
  deliveryMode   String   @db.VarChar(20)
  contact        Json
  notes          String?  @db.Text
  snapshot       Json
  pricingStatus  String   @db.VarChar(30)
  amountMinor    Int?
  currency       String?  @db.VarChar(3)
  pricingVersion String?  @db.VarChar(30)
  createdAt      DateTime @default(now())
}

enum TeamApplicationStatus {
  PENDING_REVIEW
  INTERVIEW_ASSIGNED
  ACCEPTED
  REJECTED
}

enum TeamApplicationRole {
  DEVELOPER
  PRODUCT_OWNER
}

model TeamApplication {
  resultingUserId        Int?
  decidedByUserId        Int?
  decidedAt              DateTime?
  interviewCompletedAt   DateTime?
  decisionReason         String?               @db.VarChar(1000)
  resultingUser          User?                 @relation("ApplicationAccount", fields: [resultingUserId], references: [id], onDelete: SetNull)
  decidedBy              User?                 @relation("ApplicationDecisionActor", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  id                     Int                   @id @default(autoincrement())
  code                   String                @unique @db.VarChar(100)
  email                  String                @unique @db.VarChar(150)
  dni                    String                @unique @db.VarChar(8)
  requestedRole          TeamApplicationRole
  profile                Json
  cv                     Bytes                 @db.LongBlob
  cvName                 String                @db.VarChar(255)
  photo                  Bytes                 @db.LongBlob
  photoMime              String                @db.VarChar(30)
  consent                Boolean
  status                 TeamApplicationStatus @default(PENDING_REVIEW)
  assignedAdminProfileId Int?
  reviewedByUserId       Int?
  interviewAssignedAt    DateTime?
  rejectionReason        String?               @db.VarChar(1000)
  rejectedAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  assignedAdminProfile   AdminProfile?         @relation("TeamApplicationInterviewer", fields: [assignedAdminProfileId], references: [id], onDelete: SetNull)
  reviewedByUser         User?                 @relation("TeamApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([resultingUserId])
  @@index([decidedByUserId, decidedAt])
  @@index([status, createdAt])
  @@index([requestedRole, status, createdAt])
  @@index([assignedAdminProfileId, status])
  @@index([reviewedByUserId])
}

model QuoteVersion {
  id           Int               @id @default(autoincrement())
  quoteId      Int
  version      Int
  clientUserId Int
  authorId     Int
  observations String?           @db.VarChar(2000)
  amountMinor  Decimal           @db.Decimal(15, 0)
  currency     String            @db.Char(3)
  scope        Json
  createdAt    DateTime          @default(now())
  officialAt   DateTime          @default(now())
  quote        Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  client       User              @relation("QuoteVersionClient", fields: [clientUserId], references: [id], onDelete: Restrict)
  author       User              @relation("QuoteVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  schedules    PaymentSchedule[]

  @@unique([quoteId, version])
  @@index([clientUserId, createdAt])
  @@index([authorId])
}

model PaymentSchedule {
  milestoneRecord       ProjectMilestone?
  id                    Int               @id @default(autoincrement())
  quoteVersionId        Int
  sequence              Int
  percentageBasisPoints Int
  amountMinor           Decimal           @db.Decimal(15, 0)
  dueDate               DateTime          @db.Date
  milestone             String            @db.VarChar(150)
  quoteVersion          QuoteVersion      @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  payments              Payment[]

  @@unique([quoteVersionId, sequence])
  @@index([dueDate])
}

enum PaymentStatus {
  CONFIRMED
  FAILED
}

model Payment {
  id              Int             @id @default(autoincrement())
  scheduleId      Int
  externalEventId String          @unique @db.VarChar(150)
  amountMinor     Decimal         @db.Decimal(15, 0)
  currency        String          @db.Char(3)
  status          PaymentStatus
  createdAt       DateTime        @default(now())
  schedule        PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([scheduleId, status])
}

model MeetingEvent {
  id              Int           @id @default(autoincrement())
  externalEventId String        @unique @db.VarChar(150)
  meetingId       Int
  status          MeetingStatus
  occurredAt      DateTime
  createdAt       DateTime      @default(now())
  meeting         Meeting       @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@index([meetingId, occurredAt])
}

model Kickoff {
  id        Int      @id @default(autoincrement())
  projectId Int      @unique
  actorId   Int
  heldAt    DateTime
  notes     String?  @db.VarChar(2000)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
}

model ProjectMilestone {
  id                Int                  @id @default(autoincrement())
  projectId         Int
  paymentScheduleId Int                  @unique
  title             String               @db.VarChar(150)
  dueDate           DateTime             @db.Date
  sequence          Int
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  paymentSchedule   PaymentSchedule      @relation(fields: [paymentScheduleId], references: [id], onDelete: Restrict)
  deliverables      ProjectDeliverable[]

  @@unique([projectId, sequence])
}

model AuditEvent {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(100)
  metadata   Json
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([createdAt, id])
}
